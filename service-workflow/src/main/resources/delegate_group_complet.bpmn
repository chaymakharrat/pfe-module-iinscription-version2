<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
  id="Definitions_groupeComplet"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="Camunda Modeler"
  exporterVersion="5.43.1"
  modeler:executionPlatform="Camunda Platform"
  modeler:executionPlatformVersion="7.24.0">

  <bpmn:process
    id="groupe-complet-process"
    name="groupe-complet-process"
    isExecutable="true"
    camunda:historyTimeToLive="30">

    <bpmn:startEvent id="StartEvent_1" name="Groupe complet déclenché">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:intermediateCatchEvent id="Timer_Attente" name="Attendre 5s">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask
      id="Task_Promouvoir"
      name="Promouvoir N meilleurs"
      camunda:class="com.example.workflow.delegate.completeGroupe.PromouvoirCandidatsDelegate">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Groupe complet traité">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1"
                       sourceRef="StartEvent_1"
                       targetRef="Timer_Attente"/>
    <bpmn:sequenceFlow id="Flow_2"
                       sourceRef="Timer_Attente"
                       targetRef="Task_Promouvoir"/>
    <bpmn:sequenceFlow id="Flow_3"
                       sourceRef="Task_Promouvoir"
                       targetRef="EndEvent_1"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1"
                      bpmnElement="groupe-complet-process">

      <bpmndi:BPMNShape id="StartEvent_1_di"
                        bpmnElement="StartEvent_1">
        <dc:Bounds x="172" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="151" y="145" width="80" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Timer_Attente_di"
                        bpmnElement="Timer_Attente">
        <dc:Bounds x="282" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="265" y="145" width="71" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Promouvoir_di"
                        bpmnElement="Task_Promouvoir">
        <dc:Bounds x="390" y="80" width="100" height="80"/>
        <bpmndi:BPMNLabel/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di"
                        bpmnElement="EndEvent_1">
        <dc:Bounds x="562" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="541" y="145" width="80" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="208" y="120"/>
        <di:waypoint x="282" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="318" y="120"/>
        <di:waypoint x="390" y="120"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="120"/>
        <di:waypoint x="562" y="120"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>