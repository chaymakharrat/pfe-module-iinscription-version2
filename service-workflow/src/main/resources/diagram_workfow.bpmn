      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sqlawe</bpmn:incoming>
      <bpmn:outgoing>Flow_0oackrs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Scolarite" name="Accepté?">
