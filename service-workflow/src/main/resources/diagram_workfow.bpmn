    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Reject" name="Demande rejetée">
      <bpmn:incoming>Flow_11q4ako</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_11q4ako" sourceRef="Task_NotificationRejet" targetRef="EndEvent_Reject" />
    <bpmn:endEvent id="EndEvent_Success" name="Inscription finalisée">
      <bpmn:incoming>Flow_07uk4by</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07uk4by" sourceRef="Task_FinalizeEnrollment" targetRef="EndEvent_Success" />
  </bpmn:process>
