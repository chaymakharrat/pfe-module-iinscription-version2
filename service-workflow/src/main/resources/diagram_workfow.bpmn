    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0hpenb2" sourceRef="Task_ValidationPaiement" targetRef="Task_FinalizeEnrollment" />
    <bpmn:serviceTask id="Task_FinalizeEnrollment" name="Finaliser inscription" camunda:class="com.example.workflow.delegate.FinalizeEnrollmentDelegate">
      <bpmn:incoming>Flow_0hpenb2</bpmn:incoming>
