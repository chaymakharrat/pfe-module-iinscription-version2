      <bpmn:outgoing>Flow_0n49s4t</bpmn:outgoing>
      <bpmn:outgoing>Flow_14yt231</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0oackrs" sourceRef="Task_ValidationScolarite" targetRef="Gateway_Scolarite" />
    <bpmn:sequenceFlow id="Flow_0n49s4t" name="oui" sourceRef="Gateway_Scolarite" targetRef="Task_ValidationDepartement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'ACCEPTE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ValidationDepartement" name="Validation Département">
      <bpmn:extensionElements>
