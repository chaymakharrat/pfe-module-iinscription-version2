      <bpmn:outgoing>Flow_16zxf88</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_14yt231" name="non" sourceRef="Gateway_Scolarite" targetRef="Task_NotificationRejet">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'REJETE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_NotificationRejet" name="Notification rejet" camunda:class="com.example.workflow.delegate.NotificationRejetDelegate">
