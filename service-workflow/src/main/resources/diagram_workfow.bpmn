    <bpmn:sequenceFlow id="Flow_1wz4v7a" name="oui" sourceRef="Gateway_01ncpg8" targetRef="Activity_0jdhpdg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'ACCEPTE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0jdhpdg" name="generer facture" camunda:class="com.example.workflow.delegate.GenerateInvoiceDelegate">
